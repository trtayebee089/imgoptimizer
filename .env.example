# .env.example
GEMINI_API_KEY=

# Required: MongoDB connection (usage statistics + user accounts/sessions)
MONGODB_URI=

# Optional
# PORT=3000
# Public base URL used to build password-reset links (defaults to the request host)
# APP_URL=https://optimizer.example.com
# Force the Secure cookie flag on/off (defaults to on when NODE_ENV=production)
# COOKIE_SECURE=true
# No email provider is configured. Outside production, reset links are printed to the
# server log; set this to also print them in production (only on a trusted server).
# AUTH_LOG_RESET_LINKS=false
