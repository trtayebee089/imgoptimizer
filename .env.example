# Copy to .env.local for local development and fill in real values.
# Never commit real credentials. On Vercel, set these in
# Project → Settings → Environment Variables (Production and Preview).

# --- Required ---------------------------------------------------------------

# MongoDB connection string (accounts, sessions, history, rate limits).
# Server-side only; never exposed to the browser.
MONGODB_USERNAME="tayebeetechrajshahi_db_user"
MONGODB_PASSWORD="fUHtjTU6LP1pa44f"
MONGODB_URI="mongodb+srv://tayebeetechrajshahi_db_user:fUHtjTU6LP1pa44f@imgopt.eiegxqj.mongodb.net"

# Canonical public URL, no trailing slash. Used for password-reset links,
# the canonical/Open Graph tags, robots.txt and sitemap.xml.
# Required in production: reset links are never built from the request Host header there.
APP_URL=https://imgoptz.hivelabsbd.com

# --- Email (required for password reset in production) ----------------------

# Resend (https://resend.com) API key and a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Optimizer.pro <no-reply@hivelabsbd.com>"

# --- Optional ---------------------------------------------------------------

# Public support address shown on the Help page, footer and legal pages (omit to hide).
# SUPPORT_EMAIL=support@example.com

# Local Node server port (ignored on Vercel).
# PORT=3000

# Force the Secure cookie flag on/off. Defaults to on when NODE_ENV=production.
# Secure cookies use the __Host- prefix (host-only, path=/).
# COOKIE_SECURE=true

# Express "trust proxy" setting when self-hosting behind a reverse proxy
# (e.g. 1 for one hop). Vercel is detected automatically.
# TRUST_PROXY=1

# Development fallback prints reset links to the server log. Never enable on a
# shared production server.
# AUTH_LOG_RESET_LINKS=false

# Integration tests only: a throwaway database that is DROPPED by the tests.
# Prefer `npm run test:integration`, which uses a temporary in-memory MongoDB.
# MONGODB_URI_TEST=

#tayebeetechrajshahi_db_user fUHtjTU6LP1pa44f